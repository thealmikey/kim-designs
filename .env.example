# Environment variables for Winterior Design (Next.js on Vercel).
# Copy this file to `.env.local` for local development, or set the same
# values in the Vercel dashboard (Project → Settings → Environment Variables).
#
# NEVER commit `.env`, `.env.local`, or any file containing real secrets.
# `.env*` is already in `.gitignore`.

# Public — exposed to the browser (prefixed with NEXT_PUBLIC_).
# Used in metadata, sitemap, and WhatsApp share links.
NEXT_PUBLIC_SITE_URL=https://winteriordesign.co.ke
NEXT_PUBLIC_SITE_NAME=Winterior Design
